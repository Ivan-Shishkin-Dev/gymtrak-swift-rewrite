// Copy to Secrets.xcconfig. Host only (no https://) because xcconfig treats // as a comment.
SUPABASE_HOST = YOUR-PROJECT.supabase.co
SUPABASE_KEY = sb_publishable_xxx
// Strava API app (strava.com/settings/api). Callback domain: strava
STRAVA_CLIENT_ID =
STRAVA_CLIENT_SECRET =
// Spotify developer app (developer.spotify.com). Redirect URI: gymtrak://spotify. PKCE, so no secret.
SPOTIFY_CLIENT_ID =
