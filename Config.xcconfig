// Shared build settings. Supabase, Strava and Spotify values come from Secrets.xcconfig (gitignored).
// Copy Secrets.example.xcconfig to Secrets.xcconfig and fill it in.

// Paid Apple Developer team (Ivan Shishkin). Needed for Apple Health and installing on the iPhone.
DEVELOPMENT_TEAM = WSGA5S62WA
HEALTH_ENABLED = YES
CODE_SIGN_ENTITLEMENTS = GymTrak/GymTrak.entitlements

#include? "Secrets.xcconfig"
